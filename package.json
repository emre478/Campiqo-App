{
  "name": "campiqoapp",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "api:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-api-client.ps1",
    "api:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-backend-contract.ps1",
    "test:contract": "tsx --test tests/api-contract.smoke.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.17.0",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.26",
    "expo-crypto": "~55.0.19",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.3.0"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2"
